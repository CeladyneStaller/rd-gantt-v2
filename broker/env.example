# Copy to Railway service variables (do NOT commit a filled-in copy).

# JSONBin master key — stays server-side; the browser never sees it.
JSONBIN_MASTER_KEY=your-jsonbin-master-key

# Bin ids. These MUST match the bin ids configured in the Division Tracker's
# Settings (the client still reads these bins directly). EXP is optional —
# leave unset if Exploration isn't in use; its writes will 400 until set.
JSONBIN_BIN_HUB=overall-gantt-bin-id
JSONBIN_BIN_FC=fuelcell-bin-id
JSONBIN_BIN_EL=electrolyzer-bin-id
JSONBIN_BIN_EXP=

# Bearer token the browser presents on every call: every write, and every data
# read too (/state/*, /roster, /analysis, /prefs/*; only /rdcore.js,
# /rdcore/version and /health stay open). Unset, those routes answer 500 (fail
# closed). Generate a long random string; rotate by changing it here and in the
# client's Settings. This is the revocable credential that replaces shipping the
# master key to the browser.
BROKER_TOKEN=generate-a-long-random-string

# Front-ends allowed to write a /state document: the "client" value in the PUT
# body. Anything else (an old tab sends none) gets 426 "This page is out of
# date". Optional; unset or blank means calm-1,ops (ops = migrate.py / backup_docs.py).
RD_ALLOWED_CLIENTS=calm-1,ops

# Per-person view settings (GET/PATCH /prefs/{email}) — e.g. each person's Done-column choice on a kanban,
# so it follows them to any device. Make the bin once with:  ONLY=prefs python ops/create_bins.py
# Unset, /prefs answers 503 and the apps keep these settings in each browser instead.
PREFS_BIN=

# Comma-separated allow-list of browser origins (GitHub Pages + Confluence).
# Leave unset only for local testing (falls back to '*').
ALLOWED_ORIGINS=https://celadynestaller.github.io,https://your-confluence-domain
